<mxfile host="Electron" type="device"><diagram id="pagina1" name="Comandi con argomenti"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p0c0" value="Prototipo A: comandi con argomenti" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="500" height="30" as="geometry" /></mxCell><mxCell id="p0c1" value="&amp;gt; python prenotazioni.py libere 2026-10-12 10:00 11:00 --tipo laboratorio&lt;br&gt;Laboratori liberi il 2026-10-12 dalle 10:00 alle 11:00:&lt;br&gt;&amp;nbsp;&amp;nbsp;LAB-FIS&amp;nbsp;&amp;nbsp; Laboratorio di fisica&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;24 posti&lt;br&gt;&amp;nbsp;&amp;nbsp;LAB-INF2&amp;nbsp;&amp;nbsp;Laboratorio di informatica 2&amp;nbsp;&amp;nbsp; 24 posti&lt;br&gt;&amp;nbsp;&amp;nbsp;LAB-LNG&amp;nbsp;&amp;nbsp; Laboratorio linguistico&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;30 posti&lt;br&gt;&lt;br&gt;&amp;gt; python prenotazioni.py prenota LAB-INF1 2026-10-12 10:00 11:00 &amp;quot;M. Bianchi&amp;quot;&lt;br&gt;Errore: LAB-INF1 è già prenotato dalle 09:00 alle 11:00 (prenotazione 1, M. Bianchi)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#1e1e1e;strokeColor=#555555;fontColor=#e8e8e8;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="720" height="190" as="geometry" /></mxCell><mxCell id="p0c2" value="Da discutere con il cliente:&lt;br&gt;- il docente ricorda il formato della data?&lt;br&gt;- serve un comando per le aule libere (US-05)?" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="260" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pagina2" name="Menu interattivo"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1c0" value="Prototipo B: menu interattivo" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="500" height="30" as="geometry" /></mxCell><mxCell id="p1c1" value="&amp;gt; python prenotazioni.py&lt;br&gt;PRENOTAZIONI DEI LABORATORI&lt;br&gt;&amp;nbsp;&amp;nbsp;1. Elenco delle aule&lt;br&gt;&amp;nbsp;&amp;nbsp;2. Nuova prenotazione&lt;br&gt;&amp;nbsp;&amp;nbsp;3. Prenotazioni di un giorno&lt;br&gt;&amp;nbsp;&amp;nbsp;4. Cancella una prenotazione&lt;br&gt;&amp;nbsp;&amp;nbsp;0. Esci&lt;br&gt;Scelta: 2&lt;br&gt;Aula (codice o numero dell&amp;#x27;elenco): 5&lt;br&gt;Giorno [2026-10-12]: &lt;br&gt;Ora di inizio (HH:MM): 10:00&lt;br&gt;Ora di fine (HH:MM): 11:00&lt;br&gt;Nome di chi prenota: M. Bianchi&lt;br&gt;Prenotazione 6 registrata: LAB-INF1, 2026-10-12, 10:00-11:00" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#1e1e1e;strokeColor=#555555;fontColor=#e8e8e8;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="560" height="300" as="geometry" /></mxCell><mxCell id="p1c2" value="Da discutere:&lt;br&gt;- il giorno proposto è oggi: basta Invio&lt;br&gt;- come si provano i menu con i test?&lt;br&gt;- più passaggi per chi prenota spesso" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="260" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>